PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:4200
DB_PATH=./data/ap-scout.sqlite
DB_SYNCHRONIZE=true
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
BCRYPT_ROUNDS=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
TRUST_WEIGHT_EXPERT=3.0
TRUST_WEIGHT_CHIEF=2.0
TRUST_WEIGHT_SCOUT=1.0
TRUST_WEIGHT_MECHANIC=0.5
EXPERT_CONSENSUS_MIN_WEIGHT=3.0
STORAGE_DIR=./data/storage
UPLOAD_MAX_PHOTO_MB=10
UPLOAD_MAX_VOICE_MB=5
UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
MAX_PHOTOS_PER_OBSERVATION=3
# gemini | groq | mock | local (local = only our trained classifier, no external AI; run npm run train:classifier first)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=------
# Groq model must accept images (openai/gpt-oss-* are text-only)
GROQ_API_KEY=your-key-here
GROQ_MODEL=qwen/qwen3.8-27b
# Treatment plan (POST /recommendations/:id/treatment-plan): Groq text model writes the course from registry facts.
# Needs GROQ_API_KEY; recognition stays with AI_PROVIDER. Rates, counts and intervals are re-checked against the registry
TREATMENT_PLAN_MODEL=openai/gpt-oss-120b
TREATMENT_PLAN_TEMPERATURE=0.2
TREATMENT_PLAN_TIMEOUT_MS=45000
TREATMENT_PLAN_WATER_MIN_L_PER_HA=100
TREATMENT_PLAN_WATER_MAX_L_PER_HA=400
TREATMENT_PLAN_DEFAULT_TANK_L=3000
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=1500
AI_RETRY_MAX_DELAY_MS=30000
AI_TEMPERATURE=0.2
RECOGNITION_CALIBRATION_TEMPERATURE=1.5
RECOGNITION_UNSURE_THRESHOLD=0.5
RECOGNITION_OOD_ENTROPY_THRESHOLD=0.85
RECOGNITION_CLOSE_MARGIN=0.15
RECOGNITION_TOP_K=3
RECOGNITION_MULTIFRAME_AGGREGATION=mean_log_prob
RECOGNITION_CRITICAL_RECALL_BIAS=0.1
WEATHER_PROVIDER_URL=https://api.open-meteo.com/v1/forecast
WEATHER_HORIZON_HOURS=72
WEATHER_CACHE_TTL_MINUTES=60
WEATHER_CACHE_COORD_PRECISION=2
WEATHER_TIMEOUT_MS=8000
WEATHER_MAX_WIND_MS=5
WEATHER_MIN_TEMP_C=5
WEATHER_MAX_TEMP_C=25
WEATHER_MAX_RAIN_MM=0.5
WEATHER_RAIN_FREE_HOURS=4
WEATHER_MAX_PRECIP_PROB_PCT=40
WEATHER_MAX_GUST_MS=8
WEATHER_MIN_HUMIDITY_PCT=40
WEATHER_MAX_HUMIDITY_PCT=95
SAFETY_WATER_BUFFER_M=50
SAFETY_APIARY_BUFFER_M=4000
SAFETY_SETTLEMENT_BUFFER_M=300
RECOMMENDATION_MAX_ITEMS=3
RECOMMENDATION_MAX_SAME_GROUP_PER_SEASON=2
RECOMMENDATION_SEASON_START_MONTH=3
RECOMMENDATION_RANK_WEIGHT_EFFICACY=0.5
RECOMMENDATION_RANK_WEIGHT_STOCK=0.3
RECOMMENDATION_RANK_WEIGHT_COST=0.2
RECOMMENDATION_AUTO_APPROVE_MIN_CONFIDENCE=0.9
CATALOG_STALE_DAYS=180
CATALOG_SEED_DEMO=true
CATALOG_DEFAULT_REGION=UA-DEFAULT
SYNC_BACKOFF_BASE_MS=2000
SYNC_BACKOFF_MAX_MS=300000
SYNC_BACKOFF_FACTOR=2
SYNC_BATCH_SIZE=25
SYNC_REFINE_CONCURRENCY=2
SYNC_REFINE_MAX_ATTEMPTS=5
SYNC_REFINE_RETRY_BASE_MS=60000
SYNC_REFINE_RETRY_MAX_MS=900000
SYNC_REFINE_QUOTA_PAUSE_MS=3600000
SYNC_CLIENT_CONFIG_EXPOSED=true
STOCK_LOW_THRESHOLD_FRACTION=0.1
STOCK_DEFAULT_PAGE_SIZE=20
STOCK_MAX_PAGE_SIZE=100
STOCK_IMPORT_MAX_KB=512
STOCK_DEMO_UNIT=l
STOCK_DEMO_BASE_QUANTITY=200
STOCK_DEMO_QUANTITY_STEP=150
STOCK_DEMO_OUT_OF_STOCK_EVERY_NTH=3
AUDIT_RETENTION_DAYS=730
EXPORT_PAGE_SIZE=500

FIELDS_NEARBY_LIMIT=5
FIELDS_NEARBY_MAX_KM=5
FIELDS_IMPORT_MAX_MB=20

# Expert loop (be-expert)
EXPERT_RARE_CLASS_MAX_LABELS=20
EXPERT_LOW_CONFIDENCE_THRESHOLD=0.5
EXPERT_PRIORITY_UNCERTAINTY_SCALE=20
EXPERT_PRIORITY_RARE_BONUS=15
EXPERT_PRIORITY_OUT_OF_DISTRIBUTION=80
EXPERT_PRIORITY_DISAGREEMENT=70
EXPERT_PRIORITY_UNSURE=50
EXPERT_PRIORITY_LOW_CONFIDENCE=40
EXPERT_PRIORITY_RARE_CLASS=30
EXPERT_DATASET_PAGE_SIZE=500

# be-auth: demo users seeded on first boot (dev default on, off in production unless true)
AUTH_SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=change-me-demo-password
DEMO_FARM_NAME=AP Scout Demo Farm

RECOGNITION_REFERENCES_PER_HYPOTHESIS=3
RECOGNITION_PLANTS_PER_M2=250
# plants per m2 by crop code (fallback for unlisted crops: RECOGNITION_PLANTS_PER_M2), used for pest density per m2
RECOGNITION_PLANTS_PER_M2_BY_CROP=wheat_winter:400,rapeseed:50,soybean:45,maize:7,sunflower:6
RECOGNITION_ANSWER_EVIDENCE_FACTOR=2
RECOGNITION_DEFAULT_LOCALE=uk

# Fields (be-fields) paging, validation and import limits
FIELDS_DEFAULT_PAGE_SIZE=20
FIELDS_MAX_PAGE_SIZE=100
FIELDS_NAME_MAX_LENGTH=200
FIELDS_IMPORT_MAX_UNZIPPED_MB=100
FIELDS_IMPORT_FALLBACK_NAME=Field

TASKS_DEFAULT_PAGE_SIZE=20
TASKS_MAX_PAGE_SIZE=100

RECOMMENDATION_MIN_ACTION_PROBABILITY=0.5

RECOMMENDATION_APPROACHING_THRESHOLD_FRACTION=0.7

RECOMMENDATION_DEFAULT_CROP_CYCLE_DAYS=150

RECOMMENDATION_CROP_CYCLE_DAYS=wheat_winter:300,maize:150,sunflower:130,soybean:130,rapeseed:330
RECOGNITION_PROVIDER_CONCURRENCY=2

# be-similarity: labelled reference photos in Qdrant (kNN evidence for recognition). Off = provider only.
# Index a dataset first: npm run index:references -- --dataset <folder> --mapping <file.json>  (docs/datasets/README.md)
SIMILARITY_ENABLED=false
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=crop_references
SIMILARITY_EMBEDDER_MODEL=Xenova/clip-vit-base-patch32
# fp32 | fp16 | q8 (changing model or dtype needs a new collection and re-indexing)
SIMILARITY_EMBEDDER_DTYPE=fp32
# cpu | dml (DirectML GPU on Windows). On laptops GPU 0 is often the integrated card: try 1 for the NVIDIA one
SIMILARITY_EMBEDDER_DEVICE=cpu
SIMILARITY_EMBEDDER_GPU_ID=0
SIMILARITY_MODEL_CACHE_DIR=./data/models
SIMILARITY_NEIGHBOURS=20
SIMILARITY_BLEND_WEIGHT=0.3
SIMILARITY_VOTE_EXPONENT=4
# best neighbour cosine below this -> out_of_distribution; 0 = off. CLIP scores sit around 0.8-0.95, tune on data
SIMILARITY_OOD_MIN_SCORE=0
SIMILARITY_TIMEOUT_MS=15000
SIMILARITY_INDEX_BATCH_SIZE=32
# Probe trained on the Qdrant vectors (npm run train:classifier); missing file = kNN vote. Restart after re-training
SIMILARITY_CLASSIFIER_PATH=./data/models/reference-classifier.json
SIMILARITY_TRAIN_EPOCHS=300
SIMILARITY_TRAIN_LEARNING_RATE=0.5
SIMILARITY_TRAIN_L2=0.001
SIMILARITY_TRAIN_VALIDATION_FRACTION=0.15
# Feedback loop: confirmed observations join the reference base, then the classifier retrains after this delay
SIMILARITY_TRAIN_MAX_SAMPLE_WEIGHT=10
SIMILARITY_RETRAIN_DELAY_MS=60000
# Indexed datasets live here; similar photos are served from below it
SIMILARITY_DATASETS_DIR=./data/datasets
SIMILARITY_EXAMPLES_PER_DIAGNOSIS=3
# npm run lab: embedding cache, run history and HTML training reports
SIMILARITY_LAB_DIR=./data/lab
RECOGNITION_FIELD_HISTORY_LIMIT=5
RECOGNITION_OOD_FRAME_FRACTION=0.5
RECOGNITION_MIN_FRAME_PROBABILITY=0.000001

# be-analytics: max rows per analytics/export selection, and heatmap weight of a confirmed diagnosis
ANALYTICS_MAX_ROWS=20000
ANALYTICS_CONFIRMED_WEIGHT=1

# Pull page size per entity type (keyset-paged) and tolerated device clock skew in ms (conflict detection)
SYNC_PULL_PAGE_SIZE=200
SYNC_CLOCK_SKEW_MS=120000
